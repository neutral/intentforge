# Advanced Compose only: copy to an explicit local file and edit as text.
# The npm intentforge command saves its own environments.
COMPOSE_PROJECT_NAME=intentforge-example
INTENTFORGE_CONTAINER=intentforge-example-worker
INTENTFORGE_WORKSPACE='/absolute/path/to/independent workspace'
INTENTFORGE_IMAGE=ghcr.io/neutral/intentforge@sha256:99ad8522bfee88ad04a97a7d0bf997faf20573588aba322ebd14ab23d5ab9b5e
INTENTFORGE_STATE_VOLUME=intentforge-example-state
INTENTFORGE_EXPORTS_VOLUME=intentforge-example-exports
INTENTFORGE_PORT=4800
FORGE_PORT=4310
INTENT_PORT=8787
ATLAS_PORT=4721
ATLAS_PREVIEW_PORT=4722
ATLAS_PATH=atlas
# Use ATLAS_PATH=. when atlas.md is at the selected workspace root.
# Native agent sandbox and approval settings retain host defaults.
# Add an explicit environment override to a reviewed Compose override file only
# when selecting a different policy. Approval requests need a native client.
